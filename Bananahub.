local HUB_URL = "https://raw.githubusercontent.com/aloaloalo322/sssdas/refs/heads/main/cc"
local KEYS_URL = "https://raw.githubusercontent.com/joaoscpt/Banana-cat/main/keys.txt"

local Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source'))()

local function getRemote(url)
    local s,c = pcall(function() return game:HttpGet(url.."?t="..tick()) end)
    if s then return c end
    return nil
end

local function AtivarHub()
    Rayfield:Destroy()
    loadstring(game:HttpGet(HUB_URL))()
end

local function VerificarKey(texto)
    local input = texto:gsub("%s+","")
    if input == "" then return end
    local content = getRemote(KEYS_URL)
    local valido = false
    if content then
        for linha in content:gmatch("[^\r\n]+") do
            if linha:gsub("%s+","") == input then valido = true break end
        end
    else
        if input == "R8T5-joaokey-X3Q9" or input == "F7K3-joaokey-9M2P" then valido = true end
    end
    if valido then
        AtivarHub()
    else
        Rayfield:Notify({Title = "Inválida", Content = "Key desativada", Duration = 2})
    end
end

local Window = Rayfield:CreateWindow({
   Name = "Banana Hub | Key System",
   LoadingTitle = "Banana Hub",
   LoadingSubtitle = "Carregando...",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

local Tab = Window:CreateTab("Key System", 4483362458)
getgenv().KeyInput = ""

Tab:CreateInput({
   Name = "Key",
   PlaceholderText = "", -- AGORA FICA VAZIO, NÃO MOSTRA MAIS NADA
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
       getgenv().KeyInput = Text
       VerificarKey(Text)
   end,
})

Tab:CreateButton({
   Name = "Verificar Key",
   Callback = function() VerificarKey(getgenv().KeyInput) end,
})
