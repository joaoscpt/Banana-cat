local HUB_URL = "https://raw.githubusercontent.com/aloaloalo322/sssdas/refs/heads/main/cc"
local KEYS_URL = "https://raw.githubusercontent.com/joaoscpt/Banana-cat/refs/heads/main/Banana%20hub" -- SEU ARQUIVO DE KEYS

local Rayfield
pcall(function() Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))() end)
if not Rayfield then
    Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source'))()
end

local function getKeysRealTime()
    -- o true no final do HttpGet desativa o cache do executor + ?v= aleatório desativa cache do github
    local url = KEYS_URL.."?v="..math.random(1,99999999).."&t="..tick()
    local s,c = pcall(function() return game:HttpGet(url, true) end)
    if s then return c end
    return nil
end

local function Check(k)
    k = k:gsub("%s+","")
    local keys = getKeysRealTime()
    if not keys then return false end
    for line in keys:gmatch("[^\r\n]+") do
        if line:gsub("%s+","") == k then return true end
    end
    return false
end

local function IniciarVerificacaoTempoReal(keyUsada)
    task.spawn(function()
        while task.wait(10) do -- AGORA 10 SEGUNDOS PRA SER QUASE TEMPO REAL
            local content = getKeysRealTime()
            if content then
                local aindaValida = false
                for linha in content:gmatch("[^\r\n]+") do
                    if linha:gsub("%s+","") == keyUsada then aindaValida = true break end
                end
                if not aindaValida then
                    game:GetService("Players").LocalPlayer:Kick("Key desativada pelo dono.")
                    break
                end
            end
        end
    end)
end

local Window = Rayfield:CreateWindow({
   Name = "Banana Hub",
   LoadingTitle = "Banana Hub",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

local Tab = Window:CreateTab("Key System", 4483362458)
local inputKey = ""

Tab:CreateInput({
   Name = "Key",
   PlaceholderText = "",
   RemoveTextAfterFocusLost = false,
   Callback = function(t) inputKey = t end,
})

Tab:CreateButton({
   Name = "Verificar",
   Callback = function()
        if Check(inputKey) then
            local keySalva = inputKey:gsub("%s+","")
            Rayfield:Destroy()
            IniciarVerificacaoTempoReal(keySalva)
            loadstring(game:HttpGet(HUB_URL))()
        else
            Rayfield:Notify({Title = "Inválida", Content = "Essa key não existe mais", Duration = 3})
        end
   end,
})
