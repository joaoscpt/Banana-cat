local HUB_URL = "https://raw.githubusercontent.com/aloaloalo322/sssdas/refs/heads/main/cc"
local KEYS_URL = "https://raw.githubusercontent.com/joaoscpt/Banana-cat/main/keys.txt"

local Rayfield
local ok = pcall(function()
    Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)
if not Rayfield then
    Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source'))()
end

if not Rayfield then
    warn("Rayfield não carregou")
    return
end

local function getKeys()
    local s,c = pcall(function() return game:HttpGet(KEYS_URL.."?t="..tick()) end)
    if s then return c end
    return "R8T5-joaokey-X3Q9\nF7K3-joaokey-9M2P"
end

local function Check(k)
    k = k:gsub("%s+","")
    local keys = getKeys()
    for line in keys:gmatch("[^\r\n]+") do
        if line:gsub("%s+","") == k then return true end
    end
    return false
end

local Window = Rayfield:CreateWindow({
   Name = "Banana Hub",
   LoadingTitle = "Banana Hub",
   LoadingSubtitle = "Key System",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

local Tab = Window:CreateTab("Key System", 4483362458)
local inputKey = ""

Tab:CreateInput({
   Name = "Key",
   PlaceholderText = "",
   RemoveTextAfterFocusLost = false,
   Callback = function(t) inputKey = t end,
})

Tab:CreateButton({
   Name = "Verificar",
   Callback = function()
        if Check(inputKey) then
            Rayfield:Destroy()
            loadstring(game:HttpGet(HUB_URL))()
        else
            Rayfield:Notify({Title = "Key Inválida", Content = "Foi desativada ou digitada errada", Duration = 3})
        end
   end,
})
