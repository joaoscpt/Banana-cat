local HUB_URL = "https://raw.githubusercontent.com/aloaloalo322/sssdas/refs/heads/main/cc"
local KEYS_URL = "https://raw.githubusercontent.com/joaoscpt/Banana-cat/refs/heads/main/Banana%20hub"
local HttpService = game:GetService("HttpService")

local Rayfield
pcall(function() Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))() end)
if not Rayfield then
    Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source'))()
end

local function getKeys()
    local url = KEYS_URL.."?v="..math.random(1,999999).."&t="..tick()
    local ok, content = pcall(function() return game:HttpGet(url, true) end)
    if not ok or not content then return nil end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(content) end)
    if ok2 then return decoded end
    return nil
end

local function Check(k)
    k = k:gsub("%s+","")
    local data = getKeys()
    if data and data[k] == true then -- SÓ ATIVA SE FOR true
        return true
    end
    return false
end

local function IniciarAntiBypass(keyUsada)
    task.spawn(function()
        while task.wait(10) do
            local data = getKeys()
            if data then
                if data[keyUsada] ~= true then -- se virou false ou sumiu
                    game:GetService("Players").LocalPlayer:Kick("Sua key foi desativada.")
                    break
                end
            end
        end
    end)
end

local Window = Rayfield:CreateWindow({
   Name = "Banana Hub",
   LoadingTitle = "Banana Hub",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

local Tab = Window:CreateTab("Key System", 4483362458)
local inputKey = ""

Tab:CreateInput({
   Name = "Key",
   PlaceholderText = "",
   RemoveTextAfterFocusLost = false,
   Callback = function(t) inputKey = t end,
})

Tab:CreateButton({
   Name = "Verificar",
   Callback = function()
        if Check(inputKey) then
            local keySalva = inputKey:gsub("%s+","")
            Rayfield:Destroy()
            IniciarAntiBypass(keySalva)
            loadstring(game:HttpGet(HUB_URL))()
        else
            Rayfield:Notify({Title = "Key Inválida", Content = "Essa key ta em false", Duration = 3})
        end
   end,
})
