-- CONFIGURA AQUI SEUS LINKS
local HUB_URL = "https://raw.githubusercontent.com/joaoscpt/Banana-cat/main/BananaHub.lua"
local KEYS_URL = "https://raw.githubusercontent.com/joaoscpt/Banana-cat/main/keys.txt"
local STATUS_URL = "https://raw.githubusercontent.com/joaoscpt/Banana-cat/main/status.txt"

-- Carrega Rayfield com fallback
local Rayfield
local ok = pcall(function()
    Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)
if not Rayfield then
    Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source'))()
end

local function getRemote(url)
    local s,c = pcall(function() return game:HttpGet(url.."?nocache="..tick()) end)
    if s then return c end
    return nil
end

-- CHECA SE VOCÊ DESATIVOU O KEY SYSTEM
local status = getRemote(STATUS_URL)
if status then
    status = status:gsub("%s+",""):lower()
    if status == "off" or status == "0" or status == "desativado" then
        loadstring(game:HttpGet(HUB_URL))()
        return
    end
end

-- SE TÁ ON, MOSTRA O RAYFIELD
local Window = Rayfield:CreateWindow({
   Name = "Banana Hub | Key System",
   LoadingTitle = "Banana Hub",
   LoadingSubtitle = "Carregando...",
   ConfigurationSaving = { Enabled = false },
   Discord = { Enabled = false },
   KeySystem = false
})

local Tab = Window:CreateTab("Key System", 4483362458)
getgenv().KeyInput = ""

Tab:CreateInput({
   Name = "Digite sua Key",
   PlaceholderText = "R8T5-joaokey-XXXX",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text) getgenv().KeyInput = Text end,
})

Tab:CreateButton({
   Name = "Verificar Key",
   Callback = function()
        local input = getgenv().KeyInput:gsub("%s+","")
        
        local content = getRemote(KEYS_URL)
        local valid = false
        
        if content then
            for line in content:gmatch("[^\r\n]+") do
                if line:gsub("%s+","") == input then valid = true break end
            end
        else -- fallback se github cair, usa as 2 keys fixas
            if input == "R8T5-joaokey-X3Q9" or input == "F7K3-joaokey-9M2P" then valid = true end
        end

        if valid then
            Rayfield:Notify({Title = "Correta!", Content = "Carregando Hub...", Duration = 2})
            wait(1)
            Rayfield:Destroy()
            loadstring(game:HttpGet(HUB_URL))()
        else
            Rayfield:Notify({Title = "Key Inválida", Content = "Verifica se digitou certo", Duration = 3})
        end
   end,
})
